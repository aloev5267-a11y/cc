# ============ Основные настройки ============
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://ccourierhub.ru

# ============ Безопасность ============
# Секретный ключ для хэширования (минимум 32 символа)
# Генерация: openssl rand -base64 32
ADMIN_SECRET=tfXj2qfVl/oJCoiEXuK1H+udTOrVRFGQZ+92Nj6FDF8=

# JWT секрет для сессий (минимум 32 символа)
# Генерация: openssl rand -base64 32
JWT_SECRET=byEsv81YHEJc5MzuqF2AQcC4Kef+5q4oV+hwdVUyhxg=

# ============ Telegram Bot ============
# Создайте бота через @BotFather в Telegram
TELEGRAM_BOT_TOKEN=8746791181:AAGTJNcX9YzSU9mWjG5KRK_gCXK-PthAkN0

# ============ Яндекс Метрика (опционально) ============
# Номер счетчика Яндекс.Метрики
