# ============ Окружение ============
NODE_ENV=production

# Базовый URL сайта (без слэша в конце)
NEXT_PUBLIC_APP_URL=https://example.ru

# ============ База данных (PostgreSQL) ============
# Строка подключения к PostgreSQL. Обязательна.
DATABASE_URL=postgres://user:password@localhost:5432/elwork
# Включить SSL для подключения к БД (true для managed-баз; для локального
# Postgres на той же VPS обычно не нужно).
DATABASE_SSL=false
# Максимум соединений в пуле (по умолчанию 10).
DATABASE_POOL_MAX=10

# ============ Админка ============
# Секрет для первичного создания администратора (/api/admin/setup).
# Сгенерируйте: openssl rand -base64 32
ADMIN_SECRET=

# ============ Telegram ============
# Токен Telegram-бота от @BotFather
TELEGRAM_BOT_TOKEN=
# Chat ID для уведомлений о новых заявках (необязательно)
TELEGRAM_ADMIN_CHAT_ID=
# База Telegram API (необязательно, по умолчанию https://api.telegram.org)
TELEGRAM_API_BASE=

# ============ Брендинг / контакты (необязательно) ============
NEXT_PUBLIC_BRAND_NAME=
NEXT_PUBLIC_BRAND_PREFIX=
NEXT_PUBLIC_BRAND_SUFFIX=
NEXT_PUBLIC_COMPANY_NAME=
NEXT_PUBLIC_COMPANY_ADDRESS=
NEXT_PUBLIC_COMPANY_INN=
NEXT_PUBLIC_COMPANY_OGRN=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_TELEGRAM_HANDLE=
NEXT_PUBLIC_TELEGRAM_URL=
NEXT_PUBLIC_WHATSAPP=
NEXT_PUBLIC_WHATSAPP_URL=
NEXT_PUBLIC_MAX_HANDLE=
NEXT_PUBLIC_MAX_URL=
