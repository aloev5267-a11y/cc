# Окружение
NODE_ENV=production

# Базовый URL сайта (без слэша в конце)
NEXT_PUBLIC_APP_URL=https://example.ru

# Секрет для первичного создания администратора (/api/admin/setup).
# Сгенерируйте: openssl rand -base64 32
ADMIN_SECRET=

# Секрет для подписи (если используется). Сгенерируйте: openssl rand -base64 32
JWT_SECRET=

# Токен Telegram-бота от @BotFather
TELEGRAM_BOT_TOKEN=

# ID счётчика Яндекс.Метрики
NEXT_PUBLIC_YANDEX_METRIKA_ID=
